<!DOCTYPE html>
<html>
<head>
    <title>For My Love ❤️</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <h1>To The Love of My Life 💕</h1>
    <p>You are the most beautiful part of my world.</p>

    <div class="gallery">
        <img src="photos/photo1.jpg" alt="Us">
        <img src="photos/photo2.jpg" alt="Memory">
    </div>

    <audio controls autoplay loop>
        <source src="music/song.mp3" type="audio/mpeg">
    </audio>

    <button onclick="showMessage()">Click Me ❤️</button>

    <script src="script.js"></script>
</body>
</html>
body {
    text-align: center;
    font-family: Arial;
    background: linear-gradient(to right, pink, lightcoral);
    color: white;
}

.gallery img {
    width: 250px;
    margin: 10px;
    border-radius: 15px;
}

button {
    padding: 10px 20px;
    background: white;
    color: red;
    border: none;
    border-radius: 10px;
    cursor: pointer;
}
function showMessage() {
    alert("I love you more every single day ❤️");
}
